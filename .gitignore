# Byte-compiled / cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# macOS-specific
.DS_Store

# Windows-specific
Thumbs.db
~$*

# Office lock files
~$*.doc*
~$*.xlsx

# User-generated files
*.docx
*.xlsx

# Ignore everything in word_file and excel_file
word_file/*
excel_file/*

# But keep example/template files
!word_file/README.md
!word_file/example.docx
!excel_file/JWA - CTS Design Registration Tracker Example.xlsx

# Logs or debug files
*.log
*.tmp

# VSCode settings (optional)
.vscode/
